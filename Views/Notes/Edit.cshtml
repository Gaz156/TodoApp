@model TodoApp.Models.ViewModels.NoteViewModel
@{
    ViewData["Title"] = "Edit Note";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Note</h4>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Edit" id="noteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NoteId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Created</label>
                                <input type="text" class="form-control"
                                       value="@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Last Modified</label>
                                <input type="text" class="form-control"
                                       value="@Model.ModifiedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control form-control-lg"
                               placeholder="Enter note title" id="titleInput" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="12"
                                  placeholder="Start typing your note here..."
                                  id="contentInput"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-warning" id="submitBtn">
                            <i class="bi bi-save"></i> Update Note
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Debug: Log form submission
        document.getElementById('noteForm').addEventListener('submit', function(e) {
            console.log('Form submitting...');
            console.log('Note ID:', @Model.NoteId);
            console.log('Title:', document.getElementById('titleInput').value);
            console.log('Content length:', document.getElementById('contentInput').value.length);

            // Show loading indicator
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Updating...';
            submitBtn.disabled = true;
        });
    </script>
}