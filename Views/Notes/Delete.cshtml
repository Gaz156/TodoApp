@model TodoApp.Models.Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="bi bi-trash"></i> Delete Note
                </h3>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="alert alert-warning">
                    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
                    <p>Are you sure you want to delete this note? This action cannot be undone.</p>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Note Details</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Title:</dt>
                            <dd class="col-sm-9">@Model.Title</dd>

                            <dt class="col-sm-3">Created:</dt>
                            <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>

                            <dt class="col-sm-3">Last Modified:</dt>
                            <dd class="col-sm-9">@Model.ModifiedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>

                            <dt class="col-sm-3">Content Preview:</dt>
                            <dd class="col-sm-9">
                                @if (!string.IsNullOrEmpty(Model.Content) && Model.Content.Length > 100)
                                {
                                    @Model.Content.Substring(0, 100)
                                
                                    <text>...</text>
                                }
                                else
                                {
                                    @Model.Content
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <form asp-action="Delete" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NoteId" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger" id="deleteBtn">
                            <i class="bi bi-trash"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Debug: Log delete form submission
        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            console.log('Delete form submitting...');
            console.log('Note ID:', @Model.NoteId);
            console.log('Title:', '@Model.Title');

            // Show loading indicator
            const deleteBtn = document.getElementById('deleteBtn');
            deleteBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Deleting...';
            deleteBtn.disabled = true;
        });
    </script>
}