@model TodoApp.Models.Note
@{
    ViewData["Title"] = "Note Details";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-info text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-eye"></i> Note Details
                    </h3>
                    <div>
                        <small>
                            <i class="bi bi-calendar"></i>
                            Created: @Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                        </small>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h4 class="text-primary">@Model.Title</h4>
                    <hr>
                </div>

                <div class="mb-4">
                    <h6 class="text-muted">Content:</h6>
                    <div class="border rounded p-3 bg-light">
                        @Html.Raw(Model.Content.Replace("\n", "<br>"))
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="alert alert-light">
                            <h6><i class="bi bi-info-circle"></i> Note Information</h6>
                            <div class="row">
                                <div class="col-6"><strong>Created:</strong></div>
                                <div class="col-6">@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>

                                <div class="col-6"><strong>Last Modified:</strong></div>
                                <div class="col-6">@Model.ModifiedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.NoteId" class="btn btn-warning me-2">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post"
                              style="display:inline"
                              onsubmit="return confirm('Are you sure you want to delete this note?');">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add any custom JavaScript for details view here
    </script>
}